{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "src/main.ts",
    "src/game/GameScene.ts",
    "src/game/ContentLoader.ts",
    "src/game/ContentLoader.test.ts",
    "src/game/StackerContentLoader.test.ts",
    "src/game/StackerScoring.test.ts",
    "src/game/content.ts",
    "src/save/SaveManager.ts",
    "src/save/SaveManager.test.ts"
  ]
}
