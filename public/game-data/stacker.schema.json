{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitry.local/schemas/chami-stacker-v5.json",
  "title": "Chami Packing Game Protocol v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "game", "renderer", "physics", "stacking", "assets", "pieces", "presenter", "titleScreen", "dialogue"],
  "properties": {
    "$schema": { "type": "string" },
    "protocolVersion": { "const": 5 },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "subtitle": { "type": "string" }, "version": { "type": "string", "minLength": 1 } }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background", "arenaWidth", "floorY", "dangerY"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "background": { "type": "string" }, "backgroundImage": { "type": "string" }, "arenaWidth": { "type": "number", "exclusiveMinimum": 0 }, "floorY": { "type": "number" }, "dangerY": { "type": "number" } }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gravityY", "wallThickness", "settleVelocity", "settleMs"],
      "properties": { "gravityY": { "type": "number" }, "wallThickness": { "type": "number", "exclusiveMinimum": 0 }, "settleVelocity": { "type": "number", "minimum": 0 }, "settleMs": { "type": "number", "minimum": 0 } }
    },
    "stacking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewY", "spawnPadding", "dangerGraceMs", "nextPreviewCount", "pointsPerChami", "maxPackingBonus", "bag"],
      "properties": { "previewY": { "type": "number" }, "spawnPadding": { "type": "number", "minimum": 0 }, "dangerGraceMs": { "type": "number", "minimum": 0 }, "nextPreviewCount": { "type": "integer", "minimum": 1 }, "pointsPerChami": { "type": "integer", "minimum": 2 }, "maxPackingBonus": { "type": "integer", "minimum": 0 }, "bag": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    },
    "assets": {
      "type": "object",
      "required": ["images"],
      "properties": { "images": { "type": "object", "additionalProperties": { "type": "object", "required": ["src"], "properties": { "src": { "type": "string", "minLength": 1 } } } } }
    },
    "pieces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "texture", "shape", "width", "height", "mass", "friction", "frictionAir", "restitution", "angleJitter"],
        "properties": { "name": { "type": "string" }, "texture": { "type": "string" }, "shape": { "enum": ["circle", "capsule", "rectangle", "trapezoid"] }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "radius": { "type": "number", "exclusiveMinimum": 0 }, "mass": { "type": "number", "exclusiveMinimum": 0 }, "friction": { "type": "number", "minimum": 0, "maximum": 1 }, "frictionAir": { "type": "number", "minimum": 0 }, "restitution": { "type": "number", "minimum": 0, "maximum": 1 }, "angleJitter": { "type": "number", "minimum": 0 }, "collisionWidthScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "collisionHeightScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "trapezoidSlope": { "type": "number", "minimum": 0, "maximum": 1 }, "renderOrigin": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } } }, "centerOfMass": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } } }
      }
    },
    "presenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "idle", "guide", "cheer"],
      "properties": { "name": { "type": "string" }, "idle": { "type": "string" }, "guide": { "type": "string" }, "cheer": { "type": "string" } }
    },
    "titleScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art", "eyebrow", "title", "accent", "subtitle", "cta"],
      "properties": { "art": { "type": "string" }, "eyebrow": { "type": "string" }, "title": { "type": "string" }, "accent": { "type": "string" }, "subtitle": { "type": "string" }, "cta": { "type": "string" } }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "drop", "milestone", "danger", "gameOver"],
      "properties": { "start": { "$ref": "#/$defs/lines" }, "drop": { "$ref": "#/$defs/lines" }, "milestone": { "$ref": "#/$defs/lines" }, "danger": { "$ref": "#/$defs/lines" }, "gameOver": { "$ref": "#/$defs/lines" } }
    }
  },
  "$defs": { "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
}
